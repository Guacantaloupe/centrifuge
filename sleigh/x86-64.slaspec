:fistp dst is opcode=0xDF & modrm1 & rreg=3 & rmmem:dst { };

:salc is opcode=0xD6 { };
:lar dst, src is opcode=0x0F & op2=0x02 & modrm2 & rmmem:src & rreg32:dst { };
:lsl dst, src is opcode=0x0F & op2=0x03 & modrm2 & rmmem:src & rreg32:dst { };
:pushf is opcode=0x9C { };
:popf is opcode=0x9D { };
:iret is opcode=0xCF { };
:out imm, acc is opcode=0xE4 & immb:imm & acc:src { };
:out imm, acc is opcode=0xE6 & immb:imm & acc:src { };
:in acc, imm is opcode=0xE5 & acc:dst & immb:imm { };
:in acc, imm is opcode=0xE7 & acc:dst & immb:imm { };
:filds dst is opcode=0xDF & modrm1 & rreg=0 & rmmem:dst { };
:fistps dst is opcode=0xDF & modrm1 & rreg=2 & rmmem:dst { };
:fnstsw dst is opcode=0xDF & modrm1 & rreg=7 & rmmem:dst { };
:fild dst is opcode=0xDB & modrm1 & rreg=0 & rmmem:dst { };
:fisttp dst is opcode=0xDB & modrm1 & rreg=1 & rmmem:dst { };
:fistp dst is opcode=0xDB & modrm1 & rreg=3 & rmmem:dst { };
:frndint is opcode=0xD9 & modrm1 & rreg=4 & rmreg=4 { };
