// x86-64 language module for the centrifuge SLEIGH-lite engine
// Covers the common legacy integer ISA (64-bit mode + 32/16/8-bit forms).
// Flags are NOT modeled yet: jcc conditions are placeholders (disassembly
// and branch targets are exact; decompiler flag analysis is future work).
// Magic terms: modrm1/2/3, rreg[8|16|32|64], rmreg[..], rmmem, rmval[..],
// rq[..] (opcode-low-3 reg), immb/immw/immd/immq/immv, rexw, opsz.

define arch x86;

token t15 (15) {
opcode = (7:0);
op2 = (15:8);
op3 = (23:16);
}

// ===================== MOV =====================
:mov dst, src is opcode=0x88 & modrm1 & rreg8:src & rmreg8:dst { dst = src; };
:mov dst, src is opcode=0x88 & modrm1 & rreg8:src & rmmem:dst { *(dst) = src; };
:mov dst, src is opcode=0x89 & modrm1 & rreg:src & rmreg:dst { dst = src; };
:mov dst, src is opcode=0x89 & modrm1 & rreg:src & rmmem:dst { *(dst) = src; };
:mov dst, src is opcode=0x8A & modrm1 & rreg8:dst & rmreg8:src { dst = src; };
:mov dst, src is opcode=0x8A & modrm1 & rreg8:dst & rmmem:src { dst = load(src, 1); };
:mov dst, src is opcode=0x8B & modrm1 & rreg:dst & rmreg:src { dst = src; };
:mov dst, src is opcode=0x8B & modrm1 & rreg:dst & rmmem:src { dst = load(src); };
:mov dst, imm is opcode=0xC6 & modrm1 & rreg=0 & rmreg8:dst & immb:imm { dst = imm; };
:mov dst, imm is opcode=0xC6 & modrm1 & rreg=0 & rmmem:dst & immb:imm { *(dst) = imm; };
:mov dst, imm is opcode=0xC7 & modrm1 & rreg=0 & rmreg:dst & immz:imm { dst = sext(imm, 32); };
:mov dst, imm is opcode=0xC7 & modrm1 & rreg=0 & rmmem:dst & immd:imm { *(dst) = sext(imm, 32); };
:mov dst, imm is opcode=0xB0 & rq8:dst & immb:imm { dst = imm; };
:mov dst, imm is opcode=0xB8 & rexw=0 & rq32:dst & immd:imm { dst = imm; };
:mov dst, imm is opcode=0xB8 & rexw=1 & rq64:dst & immq:imm { dst = imm; };
:mov dst, imm is opcode=0xB8 & rexw=0 & opsz=2 & rq16:dst & immw:imm { dst = imm; };
:lea dst, src is opcode=0x8D & modrm1 & rreg:dst & rmmem:src { dst = src; };

// ===================== arithmetic / logic (00-3D) =====================
:add dst, src is opcode=0x00 & modrm1 & rreg8:src & rmreg8:dst { dst = dst + src; };
:add dst, src is opcode=0x00 & modrm1 & rreg8:src & rmmem:dst { *(dst) = load(dst, 1) + src; };
:add dst, src is opcode=0x01 & modrm1 & rreg:src & rmreg:dst { dst = dst + src; };
:add dst, src is opcode=0x01 & modrm1 & rreg:src & rmmem:dst { *(dst) = load(dst) + src; };
:add dst, src is opcode=0x02 & modrm1 & rreg8:dst & rmreg8:src { dst = dst + src; };
:add dst, src is opcode=0x02 & modrm1 & rreg8:dst & rmmem:src { dst = dst + load(src, 1); };
:add dst, src is opcode=0x03 & modrm1 & rreg:dst & rmreg:src { dst = dst + src; };
:add dst, src is opcode=0x03 & modrm1 & rreg:dst & rmmem:src { dst = dst + load(src); };
:or dst, src is opcode=0x08 & modrm1 & rreg8:src & rmreg8:dst { dst = dst | src; };
:or dst, src is opcode=0x09 & modrm1 & rreg:src & rmreg:dst { dst = dst | src; };
:or dst, src is opcode=0x0A & modrm1 & rreg8:dst & rmreg8:src { dst = dst | src; };
:or dst, src is opcode=0x0B & modrm1 & rreg:dst & rmreg:src { dst = dst | src; };
:adc dst, src is opcode=0x11 & modrm1 & rreg:src & rmreg:dst { dst = dst + src; };
:adc dst, src is opcode=0x13 & modrm1 & rreg:dst & rmreg:src { dst = dst + src; };
:sbb dst, src is opcode=0x19 & modrm1 & rreg:src & rmreg:dst { dst = dst - src; };
:sbb dst, src is opcode=0x1B & modrm1 & rreg:dst & rmreg:src { dst = dst - src; };
:and dst, src is opcode=0x20 & modrm1 & rreg8:src & rmreg8:dst { dst = dst & src; };
:and dst, src is opcode=0x21 & modrm1 & rreg:src & rmreg:dst { dst = dst & src; };
:and dst, src is opcode=0x22 & modrm1 & rreg8:dst & rmreg8:src { dst = dst & src; };
:and dst, src is opcode=0x23 & modrm1 & rreg:dst & rmreg:src { dst = dst & src; };
:sub dst, src is opcode=0x28 & modrm1 & rreg8:src & rmreg8:dst { dst = dst - src; };
:sub dst, src is opcode=0x29 & modrm1 & rreg:src & rmreg:dst { dst = dst - src; };
:sub dst, src is opcode=0x2A & modrm1 & rreg8:dst & rmreg8:src { dst = dst - src; };
:sub dst, src is opcode=0x2B & modrm1 & rreg:dst & rmreg:src { dst = dst - src; };
:xor dst, src is opcode=0x30 & modrm1 & rreg8:src & rmreg8:dst { dst = dst ^ src; };
:xor dst, src is opcode=0x31 & modrm1 & rreg:src & rmreg:dst { dst = dst ^ src; };
:xor dst, src is opcode=0x32 & modrm1 & rreg8:dst & rmreg8:src { dst = dst ^ src; };
:xor dst, src is opcode=0x33 & modrm1 & rreg:dst & rmreg:src { dst = dst ^ src; };
:cmp dst, src is opcode=0x38 & modrm1 & rreg8:src & rmreg8:dst { t = dst - src; };
:cmp dst, src is opcode=0x39 & modrm1 & rreg:src & rmreg:dst { t = dst - src; };
:cmp dst, src is opcode=0x3A & modrm1 & rreg8:dst & rmreg8:src { t = dst - src; };
:cmp dst, src is opcode=0x3B & modrm1 & rreg:dst & rmreg:src { t = dst - src; };

// group 1 (80/81/83)
:add dst, imm is opcode=0x80 & modrm1 & rreg=0 & rmreg8:dst & immb:imm { dst = dst + sext(imm, 8); };
:add dst, imm is opcode=0x80 & modrm1 & rreg=0 & rmmem:dst & immb:imm { *(dst) = load(dst, 1) + sext(imm, 8); };
:or dst, imm is opcode=0x80 & modrm1 & rreg=1 & rmreg8:dst & immb:imm { dst = dst | sext(imm, 8); };
:and dst, imm is opcode=0x80 & modrm1 & rreg=4 & rmreg8:dst & immb:imm { dst = dst & sext(imm, 8); };
:sub dst, imm is opcode=0x80 & modrm1 & rreg=5 & rmreg8:dst & immb:imm { dst = dst - sext(imm, 8); };
:xor dst, imm is opcode=0x80 & modrm1 & rreg=6 & rmreg8:dst & immb:imm { dst = dst ^ sext(imm, 8); };
:cmp dst, imm is opcode=0x80 & modrm1 & rreg=7 & rmreg8:dst & immb:imm { t = dst - sext(imm, 8); };
:add dst, imm is opcode=0x81 & modrm1 & rreg=0 & rmreg:dst & immz:imm { dst = dst + sext(imm, 32); };
:add dst, imm is opcode=0x81 & modrm1 & rreg=0 & rmmem:dst & immd:imm { *(dst) = load(dst) + sext(imm, 32); };
:or dst, imm is opcode=0x81 & modrm1 & rreg=1 & rmreg:dst & immd:imm { dst = dst | sext(imm, 32); };
:and dst, imm is opcode=0x81 & modrm1 & rreg=4 & rmreg:dst & immd:imm { dst = dst & sext(imm, 32); };
:sub dst, imm is opcode=0x81 & modrm1 & rreg=5 & rmreg:dst & immd:imm { dst = dst - sext(imm, 32); };
:xor dst, imm is opcode=0x81 & modrm1 & rreg=6 & rmreg:dst & immd:imm { dst = dst ^ sext(imm, 32); };
:cmp dst, imm is opcode=0x81 & modrm1 & rreg=7 & rmreg:dst & immz:imm { t = dst - sext(imm, 32); };
:add dst, imm is opcode=0x83 & modrm1 & rreg=0 & rmreg:dst & immb:imm { dst = dst + sext(imm, 8); };
:add dst, imm is opcode=0x83 & modrm1 & rreg=0 & rmmem:dst & immb:imm { *(dst) = load(dst) + sext(imm, 8); };
:or dst, imm is opcode=0x83 & modrm1 & rreg=1 & rmreg:dst & immb:imm { dst = dst | sext(imm, 8); };
:and dst, imm is opcode=0x83 & modrm1 & rreg=4 & rmreg:dst & immb:imm { dst = dst & sext(imm, 8); };
:sub dst, imm is opcode=0x83 & modrm1 & rreg=5 & rmreg:dst & immb:imm { dst = dst - sext(imm, 8); };
:xor dst, imm is opcode=0x83 & modrm1 & rreg=6 & rmreg:dst & immb:imm { dst = dst ^ sext(imm, 8); };
:cmp dst, imm is opcode=0x83 & modrm1 & rreg=7 & rmreg:dst & immb:imm { t = dst - sext(imm, 8); };

// accumulator + imm
:add dst, imm is opcode=0x04 & rq8:dst & immb:imm { dst = dst + sext(imm, 8); };
:add dst, imm is opcode=0x05 & rexw=0 & rq32:dst & immd:imm { dst = dst + imm; };
:add dst, imm is opcode=0x05 & rexw=1 & rq64:dst & immd:imm { dst = dst + sext(imm, 32); };
:or dst, imm is opcode=0x0C & rq8:dst & immb:imm { dst = dst | sext(imm, 8); };
:or dst, imm is opcode=0x0D & rexw=0 & rq32:dst & immd:imm { dst = dst | imm; };
:and dst, imm is opcode=0x24 & rq8:dst & immb:imm { dst = dst & sext(imm, 8); };
:and dst, imm is opcode=0x25 & rexw=0 & rq32:dst & immd:imm { dst = dst & imm; };
:sub dst, imm is opcode=0x2C & rq8:dst & immb:imm { dst = dst - sext(imm, 8); };
:sub dst, imm is opcode=0x2D & rexw=0 & rq32:dst & immd:imm { dst = dst - imm; };
:xor dst, imm is opcode=0x34 & rq8:dst & immb:imm { dst = dst ^ sext(imm, 8); };
:xor dst, imm is opcode=0x35 & rexw=0 & rq32:dst & immd:imm { dst = dst ^ imm; };
:cmp dst, imm is opcode=0x3C & rq8:dst & immb:imm { t = dst - sext(imm, 8); };
:cmp dst, imm is opcode=0x3D & rexw=0 & rq32:dst & immd:imm { t = dst - imm; };

// ===================== test / xchg / inc / dec / neg / not =====================
:test dst, src is opcode=0x84 & modrm1 & rreg8:src & rmreg8:dst { t = dst & src; };
:test dst, src is opcode=0x85 & modrm1 & rreg:src & rmreg:dst { t = dst & src; };
:xchg dst, src is opcode=0x86 & modrm1 & rreg8:src & rmreg8:dst { t = dst; dst = src; src = t; };
:xchg dst, src is opcode=0x87 & modrm1 & rreg:src & rmreg:dst { t = dst; dst = src; src = t; };
:test dst, imm is opcode=0xF6 & modrm1 & rreg=0 & rmreg8:dst & immb:imm { t = dst & imm; };
:test dst, imm is opcode=0xF7 & modrm1 & rreg=0 & rmreg:dst & immz:imm { t = dst & sext(imm, 32); };
:not dst is opcode=0xF6 & modrm1 & rreg=2 & rmreg8:dst { dst = ~dst; };
:not dst is opcode=0xF7 & modrm1 & rreg=2 & rmreg:dst { dst = ~dst; };
:neg dst is opcode=0xF6 & modrm1 & rreg=3 & rmreg8:dst { dst = -dst; };
:neg dst is opcode=0xF7 & modrm1 & rreg=3 & rmreg:dst { dst = -dst; };
:mul src is opcode=0xF6 & modrm1 & rreg=4 & rmreg8:src { rq64 = rq64 * src; };
:mul src is opcode=0xF7 & modrm1 & rreg=4 & rexw=0 & rmreg32:src { rq64 = rq64 * src; };
:mul src is opcode=0xF7 & modrm1 & rreg=4 & rexw=1 & rmreg64:src { rq64 = rq64 * src; };
:imul src is opcode=0xF7 & modrm1 & rreg=5 & rexw=0 & rmreg32:src { rq64 = rq64 * src; };
:div src is opcode=0xF7 & modrm1 & rreg=6 & rexw=0 & rmreg32:src { rq64 = rq64 s/ src; };
:div src is opcode=0xF7 & modrm1 & rreg=6 & rexw=1 & rmreg64:src { rq64 = rq64 s/ src; };
:inc dst is opcode=0xFE & modrm1 & rreg=0 & rmreg8:dst { dst = dst + 1; };
:dec dst is opcode=0xFE & modrm1 & rreg=1 & rmreg8:dst { dst = dst - 1; };
:inc dst is opcode=0xFF & modrm1 & rreg=0 & rmreg:dst { dst = dst + 1; };
:inc dst is opcode=0xFF & modrm1 & rreg=0 & rmmem:dst { *(dst) = load(dst) + 1; };
:dec dst is opcode=0xFF & modrm1 & rreg=1 & rmreg:dst { dst = dst - 1; };
:call is opcode=0xFF & modrm1 & rreg=2 & rmreg:src { call src; };
:call is opcode=0xFF & modrm1 & rreg=2 & rmmem:src { call src; };
:jmp is opcode=0xFF & modrm1 & rreg=4 & rmreg:src { goto src; };
:jmp is opcode=0xFF & modrm1 & rreg=4 & rmmem:src { goto src; };
:push src is opcode=0xFF & modrm1 & rreg=6 & rmreg:src { sp = sp - 8; *(sp) = src; };
:push src is opcode=0xFF & modrm1 & rreg=6 & rmmem:src { sp = sp - 8; *(sp) = load(src); };

// ===================== push / pop =====================
:push src is opcode=0x50 & rq64:src { sp = sp - 8; *(sp) = src; };
:push src is opcode=0x51 & rq64:src { sp = sp - 8; *(sp) = src; };
:push src is opcode=0x52 & rq64:src { sp = sp - 8; *(sp) = src; };
:push src is opcode=0x53 & rq64:src { sp = sp - 8; *(sp) = src; };
:push src is opcode=0x54 & rq64:src { sp = sp - 8; *(sp) = src; };
:push src is opcode=0x55 & rq64:src { sp = sp - 8; *(sp) = src; };
:push src is opcode=0x56 & rq64:src { sp = sp - 8; *(sp) = src; };
:push src is opcode=0x57 & rq64:src { sp = sp - 8; *(sp) = src; };
:pop dst is opcode=0x58 & rq64:dst { dst = load(sp, 8); sp = sp + 8; };
:pop dst is opcode=0x59 & rq64:dst { dst = load(sp, 8); sp = sp + 8; };
:pop dst is opcode=0x5A & rq64:dst { dst = load(sp, 8); sp = sp + 8; };
:pop dst is opcode=0x5B & rq64:dst { dst = load(sp, 8); sp = sp + 8; };
:pop dst is opcode=0x5C & rq64:dst { dst = load(sp, 8); sp = sp + 8; };
:pop dst is opcode=0x5D & rq64:dst { dst = load(sp, 8); sp = sp + 8; };
:pop dst is opcode=0x5E & rq64:dst { dst = load(sp, 8); sp = sp + 8; };
:pop dst is opcode=0x5F & rq64:dst { dst = load(sp, 8); sp = sp + 8; };
:push imm is opcode=0x68 & immd:imm { sp = sp - 8; *(sp) = sext(imm, 32); };
:push imm is opcode=0x6A & immb:imm { sp = sp - 8; *(sp) = sext(imm, 8); };
:pop dst is opcode=0x8F & modrm1 & rreg=0 & rmreg:dst { dst = load(sp); sp = sp + opsz; };

// ===================== shifts / rotates =====================
:shl dst, imm is opcode=0xC1 & modrm1 & rreg=4 & rmreg:dst & immb:imm { dst = dst << zext(imm, 8); };
:shr dst, imm is opcode=0xC1 & modrm1 & rreg=5 & rmreg:dst & immb:imm { dst = dst >> zext(imm, 8); };
:shl dst is opcode=0xD1 & modrm1 & rreg=4 & rmreg:dst { dst = dst << 1; };
:shr dst is opcode=0xD1 & modrm1 & rreg=5 & rmreg:dst { dst = dst >> 1; };
:sar dst is opcode=0xD1 & modrm1 & rreg=7 & rmreg:dst { dst = dst s>> 1; };
:shl dst is opcode=0xD3 & modrm1 & rreg=4 & rmreg:dst { dst = dst << rcx; };
:shr dst is opcode=0xD3 & modrm1 & rreg=5 & rmreg:dst { dst = dst >> rcx; };
:sar dst is opcode=0xD3 & modrm1 & rreg=7 & rmreg:dst { dst = dst s>> rcx; };

// ===================== branches / calls / ret =====================
:call target is opcode=0xE8 & immd:target { call inst_next + sext(target, 32); };
:jmp target is opcode=0xE9 & immd:target { goto inst_next + sext(target, 32); };
:jmp target is opcode=0xEB & immb:target { goto inst_next + sext(target, 8); };
:jo target is opcode=0x70 & immb:target { if (0 == 0) goto inst_next + sext(target, 8); };
:jno target is opcode=0x71 & immb:target { if (0 == 0) goto inst_next + sext(target, 8); };
:jb target is opcode=0x72 & immb:target { if (0 == 0) goto inst_next + sext(target, 8); };
:jae target is opcode=0x73 & immb:target { if (0 == 0) goto inst_next + sext(target, 8); };
:je target is opcode=0x74 & immb:target { if (0 == 0) goto inst_next + sext(target, 8); };
:jne target is opcode=0x75 & immb:target { if (0 == 0) goto inst_next + sext(target, 8); };
:jbe target is opcode=0x76 & immb:target { if (0 == 0) goto inst_next + sext(target, 8); };
:ja target is opcode=0x77 & immb:target { if (0 == 0) goto inst_next + sext(target, 8); };
:js target is opcode=0x78 & immb:target { if (0 == 0) goto inst_next + sext(target, 8); };
:jns target is opcode=0x79 & immb:target { if (0 == 0) goto inst_next + sext(target, 8); };
:jp target is opcode=0x7A & immb:target { if (0 == 0) goto inst_next + sext(target, 8); };
:jnp target is opcode=0x7B & immb:target { if (0 == 0) goto inst_next + sext(target, 8); };
:jl target is opcode=0x7C & immb:target { if (0 == 0) goto inst_next + sext(target, 8); };
:jge target is opcode=0x7D & immb:target { if (0 == 0) goto inst_next + sext(target, 8); };
:jle target is opcode=0x7E & immb:target { if (0 == 0) goto inst_next + sext(target, 8); };
:jg target is opcode=0x7F & immb:target { if (0 == 0) goto inst_next + sext(target, 8); };
:jo target is opcode=0x0F & op2=0x80 & immd:target { if (0 == 0) goto inst_next + sext(target, 32); };
:jno target is opcode=0x0F & op2=0x81 & immd:target { if (0 == 0) goto inst_next + sext(target, 32); };
:jb target is opcode=0x0F & op2=0x82 & immd:target { if (0 == 0) goto inst_next + sext(target, 32); };
:jae target is opcode=0x0F & op2=0x83 & immd:target { if (0 == 0) goto inst_next + sext(target, 32); };
:je target is opcode=0x0F & op2=0x84 & immd:target { if (0 == 0) goto inst_next + sext(target, 32); };
:jne target is opcode=0x0F & op2=0x85 & immd:target { if (0 == 0) goto inst_next + sext(target, 32); };
:jbe target is opcode=0x0F & op2=0x86 & immd:target { if (0 == 0) goto inst_next + sext(target, 32); };
:ja target is opcode=0x0F & op2=0x87 & immd:target { if (0 == 0) goto inst_next + sext(target, 32); };
:js target is opcode=0x0F & op2=0x88 & immd:target { if (0 == 0) goto inst_next + sext(target, 32); };
:jns target is opcode=0x0F & op2=0x89 & immd:target { if (0 == 0) goto inst_next + sext(target, 32); };
:jp target is opcode=0x0F & op2=0x8A & immd:target { if (0 == 0) goto inst_next + sext(target, 32); };
:jnp target is opcode=0x0F & op2=0x8B & immd:target { if (0 == 0) goto inst_next + sext(target, 32); };
:jl target is opcode=0x0F & op2=0x8C & immd:target { if (0 == 0) goto inst_next + sext(target, 32); };
:jge target is opcode=0x0F & op2=0x8D & immd:target { if (0 == 0) goto inst_next + sext(target, 32); };
:jle target is opcode=0x0F & op2=0x8E & immd:target { if (0 == 0) goto inst_next + sext(target, 32); };
:jg target is opcode=0x0F & op2=0x8F & immd:target { if (0 == 0) goto inst_next + sext(target, 32); };
:ret is opcode=0xC3 { return; };
:ret n is opcode=0xC2 & immw:n { return; };
:leave is opcode=0xC9 { sp = rbp; rbp = load(sp, 8); sp = sp + 8; };
:enter a, b is opcode=0xC8 & immw:a & immb:b { };
:int3 is opcode=0xCC { };
:nop is opcode=0x90 { };
:nop m is opcode=0x0F & op2=0x1F & modrm2 & rreg=0 & rmmem:m { };
:syscall is opcode=0x0F & op2=0x05 { };
:ud2 is opcode=0x0F & op2=0x0B { };
:cpuid is opcode=0x0F & op2=0xA2 { };

// ===================== 0F-prefixed =====================
:movzx dst, src is opcode=0x0F & op2=0xB6 & modrm2 & rreg:dst & rmreg8:src { dst = zext(src, 8); };
:movzx dst, src is opcode=0x0F & op2=0xB6 & modrm2 & rreg:dst & rmmem:src { dst = zext(load(src, 1), 8); };
:movzx dst, src is opcode=0x0F & op2=0xB7 & modrm2 & rreg:dst & rmreg16:src { dst = zext(src, 16); };
:movzx dst, src is opcode=0x0F & op2=0xB7 & modrm2 & rreg:dst & rmmem:src { dst = zext(load(src, 2), 16); };
:movsx dst, src is opcode=0x0F & op2=0xBE & modrm2 & rreg:dst & rmreg8:src { dst = sext(src, 8); };
:movsx dst, src is opcode=0x0F & op2=0xBE & modrm2 & rreg:dst & rmmem:src { dst = sext(load(src, 1), 8); };
:movsx dst, src is opcode=0x0F & op2=0xBF & modrm2 & rreg:dst & rmreg16:src { dst = sext(src, 16); };
:movsx dst, src is opcode=0x0F & op2=0xBF & modrm2 & rreg:dst & rmmem:src { dst = sext(load(src, 2), 16); };
:imul dst, src is opcode=0x0F & op2=0xAF & modrm2 & rreg:dst & rmreg:src { dst = dst * src; };
:imul dst, src is opcode=0x0F & op2=0xAF & modrm2 & rreg:dst & rmmem:src { dst = dst * load(src); };
:sete dst is opcode=0x0F & op2=0x94 & modrm2 & rreg=0 & rmreg8:dst { dst = 0; };
:setne dst is opcode=0x0F & op2=0x95 & modrm2 & rreg=0 & rmreg8:dst { dst = 0; };
:setg dst is opcode=0x0F & op2=0x9F & modrm2 & rreg=0 & rmreg8:dst { dst = 0; };
:setl dst is opcode=0x0F & op2=0x9C & modrm2 & rreg=0 & rmreg8:dst { dst = 0; };
:cmovne dst, src is opcode=0x0F & op2=0x45 & modrm2 & rreg:dst & rmreg:src { dst = src; };
:cmove dst, src is opcode=0x0F & op2=0x44 & modrm2 & rreg:dst & rmreg:src { dst = src; };
:cmovg dst, src is opcode=0x0F & op2=0x4F & modrm2 & rreg:dst & rmreg:src { dst = src; };
:bsf dst, src is opcode=0x0F & op2=0xBC & modrm2 & rreg:dst & rmreg:src { dst = src; };
:bsr dst, src is opcode=0x0F & op2=0xBD & modrm2 & rreg:dst & rmreg:src { dst = src; };
:bt dst, src is opcode=0x0F & op2=0xA3 & modrm2 & rreg:src & rmreg:dst { };
:btc dst, src is opcode=0x0F & op2=0xBB & modrm2 & rreg:src & rmreg:dst { dst = dst ^ (1 << src); };
:bts dst, src is opcode=0x0F & op2=0xAB & modrm2 & rreg:src & rmreg:dst { dst = dst | (1 << src); };
:btr dst, src is opcode=0x0F & op2=0xB3 & modrm2 & rreg:src & rmreg:dst { dst = dst & ~(1 << src); };
:xadd dst, src is opcode=0x0F & op2=0xC1 & modrm2 & rreg:src & rmreg:dst { t = dst + src; dst = src; src = t; };
:cmpxchg dst, src is opcode=0x0F & op2=0xB1 & modrm2 & rreg:src & rmreg:dst { dst = src; };
:bswap dst is opcode=0x0F & op2=0xC8 & rq32:dst { };
:bswap dst is opcode=0x0F & op2=0xC9 & rq32:dst { };
:bswap dst is opcode=0x0F & op2=0xCA & rq32:dst { };
:bswap dst is opcode=0x0F & op2=0xCB & rq32:dst { };
:bswap dst is opcode=0x0F & op2=0xCC & rq32:dst { };
:bswap dst is opcode=0x0F & op2=0xCD & rq32:dst { };
:bswap dst is opcode=0x0F & op2=0xCE & rq32:dst { };
:bswap dst is opcode=0x0F & op2=0xCF & rq32:dst { };

// ===================== memory-operand forms =====================
:add dst, src is opcode=0x00 & modrm1 & rreg8:src & rmmem:dst { *(dst) = load(dst, 1) + src; };
:add dst, src is opcode=0x01 & modrm1 & rreg:src & rmmem:dst { *(dst) = load(dst) + src; };
:add dst, src is opcode=0x02 & modrm1 & rreg8:dst & rmmem:src { dst = dst + load(src, 1); };
:add dst, src is opcode=0x03 & modrm1 & rreg:dst & rmmem:src { dst = dst + load(src); };
:or dst, src is opcode=0x08 & modrm1 & rreg8:src & rmmem:dst { *(dst) = load(dst, 1) | src; };
:or dst, src is opcode=0x09 & modrm1 & rreg:src & rmmem:dst { *(dst) = load(dst) | src; };
:or dst, src is opcode=0x0A & modrm1 & rreg8:dst & rmmem:src { dst = dst | load(src, 1); };
:or dst, src is opcode=0x0B & modrm1 & rreg:dst & rmmem:src { dst = dst | load(src); };
:adc dst, src is opcode=0x10 & modrm1 & rreg8:src & rmmem:dst { *(dst) = load(dst, 1) + src; };
:adc dst, src is opcode=0x11 & modrm1 & rreg:src & rmmem:dst { *(dst) = load(dst) + src; };
:adc dst, src is opcode=0x12 & modrm1 & rreg8:dst & rmmem:src { dst = dst + load(src, 1); };
:adc dst, src is opcode=0x13 & modrm1 & rreg:dst & rmmem:src { dst = dst + load(src); };
:sbb dst, src is opcode=0x18 & modrm1 & rreg8:src & rmmem:dst { *(dst) = load(dst, 1) - src; };
:sbb dst, src is opcode=0x19 & modrm1 & rreg:src & rmmem:dst { *(dst) = load(dst) - src; };
:sbb dst, src is opcode=0x1A & modrm1 & rreg8:dst & rmmem:src { dst = dst - load(src, 1); };
:sbb dst, src is opcode=0x1B & modrm1 & rreg:dst & rmmem:src { dst = dst - load(src); };
:and dst, src is opcode=0x20 & modrm1 & rreg8:src & rmmem:dst { *(dst) = load(dst, 1) & src; };
:and dst, src is opcode=0x21 & modrm1 & rreg:src & rmmem:dst { *(dst) = load(dst) & src; };
:and dst, src is opcode=0x22 & modrm1 & rreg8:dst & rmmem:src { dst = dst & load(src, 1); };
:and dst, src is opcode=0x23 & modrm1 & rreg:dst & rmmem:src { dst = dst & load(src); };
:sub dst, src is opcode=0x28 & modrm1 & rreg8:src & rmmem:dst { *(dst) = load(dst, 1) - src; };
:sub dst, src is opcode=0x29 & modrm1 & rreg:src & rmmem:dst { *(dst) = load(dst) - src; };
:sub dst, src is opcode=0x2A & modrm1 & rreg8:dst & rmmem:src { dst = dst - load(src, 1); };
:sub dst, src is opcode=0x2B & modrm1 & rreg:dst & rmmem:src { dst = dst - load(src); };
:xor dst, src is opcode=0x30 & modrm1 & rreg8:src & rmmem:dst { *(dst) = load(dst, 1) ^ src; };
:xor dst, src is opcode=0x31 & modrm1 & rreg:src & rmmem:dst { *(dst) = load(dst) ^ src; };
:xor dst, src is opcode=0x32 & modrm1 & rreg8:dst & rmmem:src { dst = dst ^ load(src, 1); };
:xor dst, src is opcode=0x33 & modrm1 & rreg:dst & rmmem:src { dst = dst ^ load(src); };
:cmp dst, src is opcode=0x38 & modrm1 & rreg8:src & rmmem:dst { *(dst) = load(dst, 1) - src; };
:cmp dst, src is opcode=0x39 & modrm1 & rreg:src & rmmem:dst { *(dst) = load(dst) - src; };
:cmp dst, src is opcode=0x3A & modrm1 & rreg8:dst & rmmem:src { dst = dst - load(src, 1); };
:cmp dst, src is opcode=0x3B & modrm1 & rreg:dst & rmmem:src { dst = dst - load(src); };
:test dst, src is opcode=0x85 & modrm1 & rreg:src & rmmem:dst { t = load(dst) & src; };
:test dst, src is opcode=0x84 & modrm1 & rreg8:src & rmmem:dst { t = load(dst, 1) & src; };
:inc dst is opcode=0xFE & modrm1 & rreg=0 & rmmem:dst { *(dst) = load(dst, 1) + 1; };
:dec dst is opcode=0xFE & modrm1 & rreg=1 & rmmem:dst { *(dst) = load(dst, 1) - 1; };
:not dst is opcode=0xF6 & modrm1 & rreg=2 & rmmem:dst { *(dst) = ~load(dst, 1); };
:not dst is opcode=0xF7 & modrm1 & rreg=2 & rmmem:dst { *(dst) = ~load(dst); };
:neg dst is opcode=0xF6 & modrm1 & rreg=3 & rmmem:dst { *(dst) = -load(dst, 1); };
:neg dst is opcode=0xF7 & modrm1 & rreg=3 & rmmem:dst { *(dst) = -load(dst); };
:or dst, imm is opcode=0x80 & modrm1 & rreg=1 & rmmem:dst & immb:imm { *(dst) = load(dst, 1) | sext(imm, 8); };
:and dst, imm is opcode=0x80 & modrm1 & rreg=4 & rmmem:dst & immb:imm { *(dst) = load(dst, 1) & sext(imm, 8); };
:sub dst, imm is opcode=0x80 & modrm1 & rreg=5 & rmmem:dst & immb:imm { *(dst) = load(dst, 1) - sext(imm, 8); };
:xor dst, imm is opcode=0x80 & modrm1 & rreg=6 & rmmem:dst & immb:imm { *(dst) = load(dst, 1) ^ sext(imm, 8); };
:cmp dst, imm is opcode=0x80 & modrm1 & rreg=7 & rmmem:dst & immb:imm { *(dst) = load(dst, 1) - sext(imm, 8); };
:or dst, imm is opcode=0x81 & modrm1 & rreg=1 & rmmem:dst & immd:imm { *(dst) = load(dst) | sext(imm, 32); };
:and dst, imm is opcode=0x81 & modrm1 & rreg=4 & rmmem:dst & immd:imm { *(dst) = load(dst) & sext(imm, 32); };
:sub dst, imm is opcode=0x81 & modrm1 & rreg=5 & rmmem:dst & immd:imm { *(dst) = load(dst) - sext(imm, 32); };
:xor dst, imm is opcode=0x81 & modrm1 & rreg=6 & rmmem:dst & immd:imm { *(dst) = load(dst) ^ sext(imm, 32); };
:cmp dst, imm is opcode=0x81 & modrm1 & rreg=7 & rmmem:dst & immd:imm { *(dst) = load(dst) - sext(imm, 32); };
:or dst, imm is opcode=0x83 & modrm1 & rreg=1 & rmmem:dst & immb:imm { *(dst) = load(dst, 1) | sext(imm, 8); };
:and dst, imm is opcode=0x83 & modrm1 & rreg=4 & rmmem:dst & immb:imm { *(dst) = load(dst, 1) & sext(imm, 8); };
:sub dst, imm is opcode=0x83 & modrm1 & rreg=5 & rmmem:dst & immb:imm { *(dst) = load(dst, 1) - sext(imm, 8); };
:xor dst, imm is opcode=0x83 & modrm1 & rreg=6 & rmmem:dst & immb:imm { *(dst) = load(dst, 1) ^ sext(imm, 8); };
:cmp dst, imm is opcode=0x83 & modrm1 & rreg=7 & rmmem:dst & immb:imm { *(dst) = load(dst, 1) - sext(imm, 8); };

:rol dst, imm is opcode=0xC1 & modrm1 & rreg=0 & rmreg:dst & immb:imm { dst = dst << zext(imm, 8); };
:ror dst, imm is opcode=0xC1 & modrm1 & rreg=1 & rmreg:dst & immb:imm { dst = dst >> zext(imm, 8); };
:rcl dst, imm is opcode=0xC1 & modrm1 & rreg=2 & rmreg:dst & immb:imm { dst = dst << zext(imm, 8); };
:rcr dst, imm is opcode=0xC1 & modrm1 & rreg=3 & rmreg:dst & immb:imm { dst = dst >> zext(imm, 8); };
:rol dst is opcode=0xD1 & modrm1 & rreg=0 & rmreg:dst { dst = dst << 1; };
:ror dst is opcode=0xD1 & modrm1 & rreg=1 & rmreg:dst { dst = dst >> 1; };
:rcl dst is opcode=0xD1 & modrm1 & rreg=2 & rmreg:dst { dst = dst << 1; };
:rcr dst is opcode=0xD1 & modrm1 & rreg=3 & rmreg:dst { dst = dst >> 1; };
:rol dst is opcode=0xD3 & modrm1 & rreg=0 & rmreg:dst { dst = dst << rcx; };
:ror dst is opcode=0xD3 & modrm1 & rreg=1 & rmreg:dst { dst = dst >> rcx; };
:rcl dst is opcode=0xD3 & modrm1 & rreg=2 & rmreg:dst { dst = dst << rcx; };
:rcr dst is opcode=0xD3 & modrm1 & rreg=3 & rmreg:dst { dst = dst >> rcx; };
:rol dst, imm is opcode=0xC0 & modrm1 & rreg=0 & rmreg8:dst & immb:imm { dst = dst << zext(imm, 8); };
:ror dst, imm is opcode=0xC0 & modrm1 & rreg=1 & rmreg8:dst & immb:imm { dst = dst >> zext(imm, 8); };
:shl dst, imm is opcode=0xC0 & modrm1 & rreg=4 & rmreg8:dst & immb:imm { dst = dst << zext(imm, 8); };
:shr dst, imm is opcode=0xC0 & modrm1 & rreg=5 & rmreg8:dst & immb:imm { dst = dst >> zext(imm, 8); };

:cmpxchg dst, src is opcode=0x0F & op2=0xB0 & modrm2 & rreg8:src & rmmem:dst { *(dst) = src; };
:cmpxchg dst, src is opcode=0x0F & op2=0xB1 & modrm2 & rreg:src & rmmem:dst { *(dst) = src; };
:xadd dst, src is opcode=0x0F & op2=0xC0 & modrm2 & rreg8:src & rmmem:dst { *(dst) = load(dst, 1) + src; };
:xadd dst, src is opcode=0x0F & op2=0xC1 & modrm2 & rreg:src & rmmem:dst { *(dst) = load(dst) + src; };
:movsxd dst, src is opcode=0x63 & modrm1 & rreg:dst & rmreg32:src { dst = sext(src, 32); };
:movsxd dst, src is opcode=0x63 & modrm1 & rreg:dst & rmmem:src { dst = sext(load(src, 4), 32); };
:bt dst, imm is opcode=0x0F & op2=0xBA & modrm2 & rreg=4 & rmreg:dst & immb:imm { };
:bt dst, imm is opcode=0x0F & op2=0xBA & modrm2 & rreg=4 & rmmem:dst & immb:imm { };
:bts dst, imm is opcode=0x0F & op2=0xBA & modrm2 & rreg=5 & rmreg:dst & immb:imm { dst = dst | (1 << zext(imm, 8)); };
:btr dst, imm is opcode=0x0F & op2=0xBA & modrm2 & rreg=6 & rmreg:dst & immb:imm { dst = dst & ~(1 << zext(imm, 8)); };
:btc dst, imm is opcode=0x0F & op2=0xBA & modrm2 & rreg=7 & rmreg:dst & immb:imm { dst = dst ^ (1 << zext(imm, 8)); };
:bt dst, src is opcode=0x0F & op2=0xA3 & modrm2 & rreg:src & rmmem:dst { };
:btc dst, src is opcode=0x0F & op2=0xBB & modrm2 & rreg:src & rmmem:dst { *(dst) = load(dst) ^ (1 << src); };
:bts dst, src is opcode=0x0F & op2=0xAB & modrm2 & rreg:src & rmmem:dst { *(dst) = load(dst) | (1 << src); };
:btr dst, src is opcode=0x0F & op2=0xB3 & modrm2 & rreg:src & rmmem:dst { *(dst) = load(dst) & ~(1 << src); };
:movzx dst, src is opcode=0x0F & op2=0xB6 & modrm2 & rreg:dst & rmmem:src { dst = zext(load(src, 1), 8); };
:movsx dst, src is opcode=0x0F & op2=0xBE & modrm2 & rreg:dst & rmmem:src { dst = sext(load(src, 1), 8); };

// ===================== SSE =====================
:movups dst, src is opcode=0x0F & op2=0x10 & modrm2 & rmreg128:src & rreg128:dst { dst = src; };
:movups dst, src is opcode=0x0F & op2=0x10 & modrm2 & rmmem:src & rreg128:dst { dst = load(src); };
:movups dst, src is opcode=0x0F & op2=0x11 & modrm2 & rreg128:src & rmmem:dst { *(dst) = src; };
:movaps dst, src is opcode=0x0F & op2=0x28 & modrm2 & rmreg128:src & rreg128:dst { dst = src; };
:movaps dst, src is opcode=0x0F & op2=0x28 & modrm2 & rmmem:src & rreg128:dst { dst = load(src); };
:movaps dst, src is opcode=0x0F & op2=0x29 & modrm2 & rreg128:src & rmmem:dst { *(dst) = src; };
:movdqa dst, src is opcode=0x0F & op2=0x6F & modrm2 & rmreg128:src & rreg128:dst { dst = src; };
:movdqa dst, src is opcode=0x0F & op2=0x6F & modrm2 & rmmem:src & rreg128:dst { dst = load(src); };
:movdqa dst, src is opcode=0x0F & op2=0x7F & modrm2 & rreg128:src & rmmem:dst { *(dst) = src; };
:xorps dst, src is opcode=0x0F & op2=0x57 & modrm2 & rmreg128:src & rreg128:dst { dst = dst ^ src; };
:addps dst, src is opcode=0x0F & op2=0x58 & modrm2 & rmreg128:src & rreg128:dst { dst = dst + src; };
:subps dst, src is opcode=0x0F & op2=0x5C & modrm2 & rmreg128:src & rreg128:dst { dst = dst - src; };
:mulps dst, src is opcode=0x0F & op2=0x59 & modrm2 & rmreg128:src & rreg128:dst { dst = dst * src; };
:divps dst, src is opcode=0x0F & op2=0x5E & modrm2 & rmreg128:src & rreg128:dst { dst = dst s/ src; };
:pxor dst, src is opcode=0x0F & op2=0xEF & modrm2 & rmreg128:src & rreg128:dst { dst = dst ^ src; };
:mov dst, imm is opcode=0xB1 & rexw=0 & rq32:dst & immd:imm { dst = imm; };
:mov dst, imm is opcode=0xB1 & rexw=1 & rq64:dst & immq:imm { dst = imm; };
:mov dst, imm is opcode=0xB2 & rexw=0 & rq32:dst & immd:imm { dst = imm; };
:mov dst, imm is opcode=0xB2 & rexw=1 & rq64:dst & immq:imm { dst = imm; };
:mov dst, imm is opcode=0xB3 & rexw=0 & rq32:dst & immd:imm { dst = imm; };
:mov dst, imm is opcode=0xB3 & rexw=1 & rq64:dst & immq:imm { dst = imm; };
:mov dst, imm is opcode=0xB4 & rexw=0 & rq32:dst & immd:imm { dst = imm; };
:mov dst, imm is opcode=0xB4 & rexw=1 & rq64:dst & immq:imm { dst = imm; };
:mov dst, imm is opcode=0xB5 & rexw=0 & rq32:dst & immd:imm { dst = imm; };
:mov dst, imm is opcode=0xB5 & rexw=1 & rq64:dst & immq:imm { dst = imm; };
:mov dst, imm is opcode=0xB6 & rexw=0 & rq32:dst & immd:imm { dst = imm; };
:mov dst, imm is opcode=0xB6 & rexw=1 & rq64:dst & immq:imm { dst = imm; };
:mov dst, imm is opcode=0xB7 & rexw=0 & rq32:dst & immd:imm { dst = imm; };
:mov dst, imm is opcode=0xB7 & rexw=1 & rq64:dst & immq:imm { dst = imm; };
:mov dst, imm is opcode=0xB8 & rexw=0 & rq32:dst & immd:imm { dst = imm; };
:mov dst, imm is opcode=0xB8 & rexw=1 & rq64:dst & immq:imm { dst = imm; };
:mov dst, imm is opcode=0xB9 & rexw=0 & rq32:dst & immd:imm { dst = imm; };
:mov dst, imm is opcode=0xB9 & rexw=1 & rq64:dst & immq:imm { dst = imm; };
:mov dst, imm is opcode=0xBA & rexw=0 & rq32:dst & immd:imm { dst = imm; };
:mov dst, imm is opcode=0xBA & rexw=1 & rq64:dst & immq:imm { dst = imm; };
:mov dst, imm is opcode=0xBB & rexw=0 & rq32:dst & immd:imm { dst = imm; };
:mov dst, imm is opcode=0xBB & rexw=1 & rq64:dst & immq:imm { dst = imm; };
:mov dst, imm is opcode=0xBC & rexw=0 & rq32:dst & immd:imm { dst = imm; };
:mov dst, imm is opcode=0xBC & rexw=1 & rq64:dst & immq:imm { dst = imm; };
:mov dst, imm is opcode=0xBD & rexw=0 & rq32:dst & immd:imm { dst = imm; };
:mov dst, imm is opcode=0xBD & rexw=1 & rq64:dst & immq:imm { dst = imm; };
:mov dst, imm is opcode=0xBE & rexw=0 & rq32:dst & immd:imm { dst = imm; };
:mov dst, imm is opcode=0xBE & rexw=1 & rq64:dst & immq:imm { dst = imm; };
:mov dst, imm is opcode=0xBF & rexw=0 & rq32:dst & immd:imm { dst = imm; };
:mov dst, imm is opcode=0xBF & rexw=1 & rq64:dst & immq:imm { dst = imm; };
:mov dst, imm is opcode=0xB1 & rq8:dst & immb:imm { dst = imm; };
:mov dst, imm is opcode=0xB2 & rq8:dst & immb:imm { dst = imm; };
:mov dst, imm is opcode=0xB3 & rq8:dst & immb:imm { dst = imm; };
:mov dst, imm is opcode=0xB4 & rq8:dst & immb:imm { dst = imm; };
:mov dst, imm is opcode=0xB5 & rq8:dst & immb:imm { dst = imm; };
:mov dst, imm is opcode=0xB6 & rq8:dst & immb:imm { dst = imm; };
:mov dst, imm is opcode=0xB7 & rq8:dst & immb:imm { dst = imm; };

:xchg dst, src is opcode=0x86 & modrm1 & rreg8:src & rmmem:dst { t = load(dst, 1); *(dst) = src; src = t; };
:xchg dst, src is opcode=0x87 & modrm1 & rreg:src & rmmem:dst { t = load(dst); *(dst) = src; src = t; };
:xchg dst, src is opcode=0x91 & rq64:dst & rq64:src { t = dst; dst = src; src = t; };
:xchg dst, src is opcode=0x92 & rq64:dst & rq64:src { t = dst; dst = src; src = t; };
:xchg dst, src is opcode=0x93 & rq64:dst & rq64:src { t = dst; dst = src; src = t; };
:xchg dst, src is opcode=0x94 & rq64:dst & rq64:src { t = dst; dst = src; src = t; };
:xchg dst, src is opcode=0x95 & rq64:dst & rq64:src { t = dst; dst = src; src = t; };
:xchg dst, src is opcode=0x96 & rq64:dst & rq64:src { t = dst; dst = src; src = t; };
:xchg dst, src is opcode=0x97 & rq64:dst & rq64:src { t = dst; dst = src; src = t; };

:int n is opcode=0xCD & immb:n { };
:movabs dst, src is opcode=0xA1 & rexw=1 & rq64:dst & immq:src { dst = src; };
