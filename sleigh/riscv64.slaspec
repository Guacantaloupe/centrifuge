// RISC-V RV64IMC language module for the centrifuge SLEIGH-lite engine
// Spec language subset documented in include/centrifuge/sleigh.hpp and ROADMAP v0.3
// Covers: RV64I + M extension + W-variants + compressed (C) extension.

define space ram size=8 type=ram_space default;
define space regs size=8 type=register_space;

define register offset=0 size=8 [
  zero ra sp gp tp t0 t1 t2 s0 s1 a0 a1 a2 a3 a4 a5 a6 a7
  s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 t3 t4 t5 t6
];

// ===================== compressed (C extension, 16-bit) =====================
token t16 (2) {
  quad    = (1:0);
  f3c     = (15:13);
  f2c     = (12:11);
  b12c    = (12:12);   // quadrant2 funct4 high bit (bit11 belongs to rd!)
  f2hi    = (11:10);   // quadrant1 shamt/imm ops selector (bit12 is imm[5])
  funct6c = (15:10);
  subop   = (6:5);
  rdc     = (11:7);
  rs2c    = (6:2);
  rd8c    = (4:2);   // x8 + field
  rs18c   = (9:7);   // x8 + field
  shamt6  = (12:12)@5, (6:2)@0;
  i_addi  = (12:12)@5, (6:2)@0;
  i_cj    = (12:12)@11, (8:8)@10, (10:10)@9, (9:9)@8, (6:6)@7, (7:7)@6, (2:2)@5, (11:11)@4, (5:3)@1;
  i_cb    = (12:12)@8, (6:5)@6, (2:2)@5, (11:10)@3, (4:3)@1;
  i_lw    = (5:5)@7, (12:10)@4, (6:6)@3;   // uimm << 2
  i_ld    = (6:5)@8, (12:10)@6;            // uimm << 3
  i_addi4 = (10:7)@4, (12:11)@8, (5:5)@3, (6:6)@2;  // nzuimm << 2
  i_addi16 = (12:12)@9, (4:4)@8, (3:3)@7, (5:5)@6, (2:2)@5, (6:6)@4;  // << 4
  i_lui   = (12:12)@5, (6:2)@0;
  i_lwsp  = (3:2)@2, (12:12)@4, (6:4)@5;   // uimm << 2
  i_ldsp  = (4:2)@6, (12:12)@5, (6:5)@3;   // uimm << 3
  i_swsp  = (8:7)@6, (12:9)@2;             // uimm << 2
  i_sdsp  = (9:7)@6, (12:10)@3;            // uimm << 3
}

attach variables [ rdc ] [ zero ra sp gp tp t0 t1 t2 s0 s1 a0 a1 a2 a3 a4 a5 a6 a7 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 t3 t4 t5 t6 ];
attach variables [ rs2c ] [ zero ra sp gp tp t0 t1 t2 s0 s1 a0 a1 a2 a3 a4 a5 a6 a7 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 t3 t4 t5 t6 ];
attach variables [ rd8c ] [ s0 s1 a0 a1 a2 a3 a4 a5 ];
attach variables [ rs18c ] [ s0 s1 a0 a1 a2 a3 a4 a5 ];

:c.addi4spn rd, imm is quad=0 & f3c=0 & rd8c:rd & i_addi4:imm { rd = sp + zext(imm, 10); };
:c.lw rd, rs1, imm is quad=0 & f3c=2 & rd8c:rd & rs18c:rs1 & i_lw:imm { rd = sext(load(rs1 + zext(imm, 8), 4), 32); };
:c.ld rd, rs1, imm is quad=0 & f3c=3 & rd8c:rd & rs18c:rs1 & i_ld:imm { rd = load(rs1 + zext(imm, 9), 8); };
:c.sw rs2, rs1, imm is quad=0 & f3c=6 & rd8c:rs2 & rs18c:rs1 & i_lw:imm { *(rs1 + zext(imm, 8)) = zext(rs2, 32); };
:c.sd rs2, rs1, imm is quad=0 & f3c=7 & rd8c:rs2 & rs18c:rs1 & i_ld:imm { *(rs1 + zext(imm, 9)) = rs2; };

:c.nop is quad=1 & f3c=0 & rdc=0 & i_addi=0 { };
:c.addi rd, imm is quad=1 & f3c=0 & rdc:rd & i_addi:imm { rd = rd + sext(imm, 6); };
:c.addiw rd, imm is quad=1 & f3c=1 & rdc:rd & i_addi:imm { rd = sext(rd + sext(imm, 6), 32); };
:c.li rd, imm is quad=1 & f3c=2 & rdc:rd & i_addi:imm { rd = sext(imm, 6); };
:c.addi16sp is quad=1 & f3c=3 & rdc=2 & i_addi16:imm { sp = sp + sext(imm, 10); };
:c.lui rd, imm is quad=1 & f3c=3 & rdc:rd & i_lui:imm { rd = sext(imm, 6) << 12; };
:c.srli rd, shamt is quad=1 & f3c=4 & f2hi=0 & rs18c:rd & shamt6:shamt { rd = rd >> zext(shamt, 6); };
:c.srai rd, shamt is quad=1 & f3c=4 & f2hi=1 & rs18c:rd & shamt6:shamt { rd = rd s>> zext(shamt, 6); };
:c.andi rd, imm is quad=1 & f3c=4 & f2hi=2 & rs18c:rd & i_addi:imm { rd = rd & sext(imm, 6); };
:c.sub rd, rs2 is quad=1 & f3c=4 & f2hi=3 & funct6c=0x23 & subop=0 & rs18c:rd & rd8c:rs2 { rd = rd - rs2; };
:c.xor rd, rs2 is quad=1 & f3c=4 & f2hi=3 & funct6c=0x23 & subop=1 & rs18c:rd & rd8c:rs2 { rd = rd ^ rs2; };
:c.or rd, rs2 is quad=1 & f3c=4 & f2hi=3 & funct6c=0x23 & subop=2 & rs18c:rd & rd8c:rs2 { rd = rd | rs2; };
:c.and rd, rs2 is quad=1 & f3c=4 & f2hi=3 & funct6c=0x23 & subop=3 & rs18c:rd & rd8c:rs2 { rd = rd & rs2; };
:c.subw rd, rs2 is quad=1 & f3c=4 & f2hi=3 & funct6c=0x27 & subop=0 & rs18c:rd & rd8c:rs2 { rd = sext(rd - rs2, 32); };
:c.addw rd, rs2 is quad=1 & f3c=4 & f2hi=3 & funct6c=0x27 & subop=1 & rs18c:rd & rd8c:rs2 { rd = sext(rd + rs2, 32); };
:c.j target is quad=1 & f3c=5 & i_cj:target { goto inst_start + sext(target, 12); };
:c.beqz rs1, target is quad=1 & f3c=6 & rs18c:rs1 & i_cb:target { if (rs1 == 0) goto inst_start + sext(target, 9); };
:c.bnez rs1, target is quad=1 & f3c=7 & rs18c:rs1 & i_cb:target { if (rs1 != 0) goto inst_start + sext(target, 9); };

:ret is quad=2 & f3c=4 & b12c=0 & rdc=1 & rs2c=0 { return; };
:c.jr rs1 is quad=2 & f3c=4 & b12c=0 & rs2c=0 & rdc:rs1 { goto rs1; };
:c.mv rd, rs2 is quad=2 & f3c=4 & b12c=0 & rdc:rd & rs2c:rs2 { rd = rs2; };
:c.ebreak is quad=2 & f3c=4 & b12c=1 & rdc=0 & rs2c=0 { };
:c.jalr rd is quad=2 & f3c=4 & b12c=1 & rs2c=0 & rdc:rd { call rd; };
:c.add rd, rs2 is quad=2 & f3c=4 & b12c=1 & rdc:rd & rs2c:rs2 { rd = rd + rs2; };
:c.slli rd, shamt is quad=2 & f3c=0 & rdc:rd & shamt6:shamt { rd = rd << zext(shamt, 6); };
:c.lwsp rd, imm is quad=2 & f3c=2 & rdc:rd & i_lwsp:imm { rd = sext(load(sp + zext(imm, 8), 4), 32); };
:c.ldsp rd, imm is quad=2 & f3c=3 & rdc:rd & i_ldsp:imm { rd = load(sp + zext(imm, 9), 8); };
:c.swsp rs2, imm is quad=2 & f3c=6 & rs2c:rs2 & i_swsp:imm { *(sp + zext(imm, 8)) = zext(rs2, 32); };
:c.sdsp rs2, imm is quad=2 & f3c=7 & rs2c:rs2 & i_sdsp:imm { *(sp + zext(imm, 9)) = rs2; };

// ===================== base (32-bit) =====================
token t32 (4) {
  opcode = (6:0);
  rd     = (11:7);
  funct3 = (14:12);
  rs1    = (19:15);
  rs2    = (24:20);
  funct7 = (31:25);
  imm12  = (31:20);
  imm20  = (31:12);
  shamt  = (25:20);
  funct6 = (31:26);
  simm12 = (31:25)@5, (11:7)@0;
  bimm12 = (31:31)@12, (7:7)@11, (30:25)@5, (11:8)@1;
  jimm20 = (31:31)@20, (19:12)@12, (20:20)@11, (30:21)@1;
}

attach variables [ rd ] [ zero ra sp gp tp t0 t1 t2 s0 s1 a0 a1 a2 a3 a4 a5 a6 a7 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 t3 t4 t5 t6 ];
attach variables [ rs1 ] [ zero ra sp gp tp t0 t1 t2 s0 s1 a0 a1 a2 a3 a4 a5 a6 a7 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 t3 t4 t5 t6 ];
attach variables [ rs2 ] [ zero ra sp gp tp t0 t1 t2 s0 s1 a0 a1 a2 a3 a4 a5 a6 a7 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 t3 t4 t5 t6 ];

// ---- system / misc ----
:ecall is opcode=0x73 & funct3=0 & imm12=0 & rs1=0 & rd=0 { };
:ebreak is opcode=0x73 & funct3=0 & imm12=1 & rs1=0 & rd=0 { };
// CSR ops: semantics not modeled (rd = 0 keeps dataflow simple); decode + control flow only
:csrrw rd, csr, rs1 is opcode=0x73 & funct3=1 & rd & imm12:csr & rs1 { rd = 0; };
:csrrs rd, csr, rs1 is opcode=0x73 & funct3=2 & rd & imm12:csr & rs1 { rd = 0; };
:csrrc rd, csr, rs1 is opcode=0x73 & funct3=3 & rd & imm12:csr & rs1 { rd = 0; };
:csrrwi rd, csr, imm is opcode=0x73 & funct3=5 & rd & imm12:csr & rs2:imm { rd = 0; };
:csrrsi rd, csr, imm is opcode=0x73 & funct3=6 & rd & imm12:csr & rs2:imm { rd = 0; };
:csrrci rd, csr, imm is opcode=0x73 & funct3=7 & rd & imm12:csr & rs2:imm { rd = 0; };
:fence is opcode=0x0F & funct3=0 { };
:fence.i is opcode=0x0F & funct3=1 { };

// ---- upper immediates ----
:lui rd, imm is opcode=0x37 & rd & imm20:imm { rd = sext(imm, 20) << 12; };
:auipc rd, imm is opcode=0x17 & rd & imm20:imm { rd = inst_start + (sext(imm, 20) << 12); };

// ---- jumps (specific forms first) ----
:call target is opcode=0x6F & rd=1 & jimm20:target { ra = inst_next; call inst_start + sext(target, 21); };
:jal rd, target is opcode=0x6F & rd & jimm20:target { rd = inst_next; goto inst_start + sext(target, 21); };
:ret is opcode=0x67 & funct3=0 & rd=0 & rs1=1 & imm12=0 { return; };
:callr rs1, imm is opcode=0x67 & funct3=0 & rd=1 & rs1 & imm12:imm { t = rs1 + sext(imm, 12); ra = inst_next; call t; };
:jalr rd, rs1, imm is opcode=0x67 & funct3=0 & rd & rs1 & imm12:imm { t = rs1 + sext(imm, 12); rd = inst_next; goto t; };

// ---- branches ----
:beq rs1, rs2, target is opcode=0x63 & funct3=0 & rs1 & rs2 & bimm12:target { if (rs1 == rs2) goto inst_start + sext(target, 12); };
:bne rs1, rs2, target is opcode=0x63 & funct3=1 & rs1 & rs2 & bimm12:target { if (rs1 != rs2) goto inst_start + sext(target, 12); };
:blt rs1, rs2, target is opcode=0x63 & funct3=4 & rs1 & rs2 & bimm12:target { if (rs1 s< rs2) goto inst_start + sext(target, 12); };
:bge rs1, rs2, target is opcode=0x63 & funct3=5 & rs1 & rs2 & bimm12:target { if (rs1 s>= rs2) goto inst_start + sext(target, 12); };
:bltu rs1, rs2, target is opcode=0x63 & funct3=6 & rs1 & rs2 & bimm12:target { if (rs1 < rs2) goto inst_start + sext(target, 12); };
:bgeu rs1, rs2, target is opcode=0x63 & funct3=7 & rs1 & rs2 & bimm12:target { if (rs1 >= rs2) goto inst_start + sext(target, 12); };

// ---- loads ----
:lb rd, rs1, imm is opcode=0x03 & funct3=0 & rd & rs1 & imm12:imm { rd = sext(load(rs1 + sext(imm, 12), 1), 8); };
:lh rd, rs1, imm is opcode=0x03 & funct3=1 & rd & rs1 & imm12:imm { rd = sext(load(rs1 + sext(imm, 12), 2), 16); };
:lw rd, rs1, imm is opcode=0x03 & funct3=2 & rd & rs1 & imm12:imm { rd = sext(load(rs1 + sext(imm, 12), 4), 32); };
:ld rd, rs1, imm is opcode=0x03 & funct3=3 & rd & rs1 & imm12:imm { rd = load(rs1 + sext(imm, 12), 8); };
:lbu rd, rs1, imm is opcode=0x03 & funct3=4 & rd & rs1 & imm12:imm { rd = zext(load(rs1 + sext(imm, 12), 1), 8); };
:lhu rd, rs1, imm is opcode=0x03 & funct3=5 & rd & rs1 & imm12:imm { rd = zext(load(rs1 + sext(imm, 12), 2), 16); };
:lwu rd, rs1, imm is opcode=0x03 & funct3=6 & rd & rs1 & imm12:imm { rd = zext(load(rs1 + sext(imm, 12), 4), 32); };

// ---- stores ----
:sb rs2, rs1, imm is opcode=0x23 & funct3=0 & rs2 & rs1 & simm12:imm { *(rs1 + sext(imm, 12)) = zext(rs2, 8); };
:sh rs2, rs1, imm is opcode=0x23 & funct3=1 & rs2 & rs1 & simm12:imm { *(rs1 + sext(imm, 12)) = zext(rs2, 16); };
:sw rs2, rs1, imm is opcode=0x23 & funct3=2 & rs2 & rs1 & simm12:imm { *(rs1 + sext(imm, 12)) = zext(rs2, 32); };
:sd rs2, rs1, imm is opcode=0x23 & funct3=3 & rs2 & rs1 & simm12:imm { *(rs1 + sext(imm, 12)) = rs2; };

// ---- OP-IMM ----
:addi rd, rs1, imm is opcode=0x13 & funct3=0 & rd & rs1 & imm12:imm { rd = rs1 + sext(imm, 12); };
:slti rd, rs1, imm is opcode=0x13 & funct3=2 & rd & rs1 & imm12:imm { rd = rs1 s< sext(imm, 12); };
:sltiu rd, rs1, imm is opcode=0x13 & funct3=3 & rd & rs1 & imm12:imm { rd = rs1 < sext(imm, 12); };
:xori rd, rs1, imm is opcode=0x13 & funct3=4 & rd & rs1 & imm12:imm { rd = rs1 ^ sext(imm, 12); };
:ori rd, rs1, imm is opcode=0x13 & funct3=6 & rd & rs1 & imm12:imm { rd = rs1 | sext(imm, 12); };
:andi rd, rs1, imm is opcode=0x13 & funct3=7 & rd & rs1 & imm12:imm { rd = rs1 & sext(imm, 12); };
:slli rd, rs1, shamt is opcode=0x13 & funct3=1 & funct6=0 & rd & rs1 & shamt { rd = rs1 << zext(shamt, 6); };
:srli rd, rs1, shamt is opcode=0x13 & funct3=5 & funct6=0 & rd & rs1 & shamt { rd = rs1 >> zext(shamt, 6); };
:srai rd, rs1, shamt is opcode=0x13 & funct3=5 & funct6=0x10 & rd & rs1 & shamt { rd = rs1 s>> zext(shamt, 6); };

// ---- OP-IMM-32 ----
:addiw rd, rs1, imm is opcode=0x1B & funct3=0 & rd & rs1 & imm12:imm { rd = sext(rs1 + sext(imm, 12), 32); };
:slliw rd, rs1, shamt is opcode=0x1B & funct3=1 & funct7=0 & rd & rs1 & shamt { rd = sext(rs1 << zext(shamt, 5), 32); };
:srliw rd, rs1, shamt is opcode=0x1B & funct3=5 & funct7=0 & rd & rs1 & shamt { rd = sext(rs1 >> zext(shamt, 5), 32); };
:sraiw rd, rs1, shamt is opcode=0x1B & funct3=5 & funct7=0x20 & rd & rs1 & shamt { rd = sext(rs1 s>> zext(shamt, 5), 32); };

// ---- OP ----
:add rd, rs1, rs2 is opcode=0x33 & funct3=0 & funct7=0 & rd & rs1 & rs2 { rd = rs1 + rs2; };
:sub rd, rs1, rs2 is opcode=0x33 & funct3=0 & funct7=0x20 & rd & rs1 & rs2 { rd = rs1 - rs2; };
:sll rd, rs1, rs2 is opcode=0x33 & funct3=1 & funct7=0 & rd & rs1 & rs2 { rd = rs1 << rs2; };
:slt rd, rs1, rs2 is opcode=0x33 & funct3=2 & funct7=0 & rd & rs1 & rs2 { rd = rs1 s< rs2; };
:sltu rd, rs1, rs2 is opcode=0x33 & funct3=3 & funct7=0 & rd & rs1 & rs2 { rd = rs1 < rs2; };
:xor rd, rs1, rs2 is opcode=0x33 & funct3=4 & funct7=0 & rd & rs1 & rs2 { rd = rs1 ^ rs2; };
:srl rd, rs1, rs2 is opcode=0x33 & funct3=5 & funct7=0 & rd & rs1 & rs2 { rd = rs1 >> rs2; };
:sra rd, rs1, rs2 is opcode=0x33 & funct3=5 & funct7=0x20 & rd & rs1 & rs2 { rd = rs1 s>> rs2; };
:or rd, rs1, rs2 is opcode=0x33 & funct3=6 & funct7=0 & rd & rs1 & rs2 { rd = rs1 | rs2; };
:and rd, rs1, rs2 is opcode=0x33 & funct3=7 & funct7=0 & rd & rs1 & rs2 { rd = rs1 & rs2; };

// ---- M extension ----
:mul rd, rs1, rs2 is opcode=0x33 & funct3=0 & funct7=1 & rd & rs1 & rs2 { rd = rs1 * rs2; };
:mulh rd, rs1, rs2 is opcode=0x33 & funct3=1 & funct7=1 & rd & rs1 & rs2 { rd = rs1 * rs2; };
:mulhsu rd, rs1, rs2 is opcode=0x33 & funct3=2 & funct7=1 & rd & rs1 & rs2 { rd = rs1 * rs2; };
:mulhu rd, rs1, rs2 is opcode=0x33 & funct3=3 & funct7=1 & rd & rs1 & rs2 { rd = rs1 * rs2; };
:div rd, rs1, rs2 is opcode=0x33 & funct3=4 & funct7=1 & rd & rs1 & rs2 { rd = rs1 s/ rs2; };
:divu rd, rs1, rs2 is opcode=0x33 & funct3=5 & funct7=1 & rd & rs1 & rs2 { rd = rs1 / rs2; };
:rem rd, rs1, rs2 is opcode=0x33 & funct3=6 & funct7=1 & rd & rs1 & rs2 { rd = rs1 s% rs2; };
:remu rd, rs1, rs2 is opcode=0x33 & funct3=7 & funct7=1 & rd & rs1 & rs2 { rd = rs1 % rs2; };

// ---- OP-32 ----
:addw rd, rs1, rs2 is opcode=0x3B & funct3=0 & funct7=0 & rd & rs1 & rs2 { rd = sext(rs1 + rs2, 32); };
:subw rd, rs1, rs2 is opcode=0x3B & funct3=0 & funct7=0x20 & rd & rs1 & rs2 { rd = sext(rs1 - rs2, 32); };
:sllw rd, rs1, rs2 is opcode=0x3B & funct3=1 & funct7=0 & rd & rs1 & rs2 { rd = sext(rs1 << rs2, 32); };
:srlw rd, rs1, rs2 is opcode=0x3B & funct3=5 & funct7=0 & rd & rs1 & rs2 { rd = sext(rs1 >> rs2, 32); };
:sraw rd, rs1, rs2 is opcode=0x3B & funct3=5 & funct7=0x20 & rd & rs1 & rs2 { rd = sext(rs1 s>> rs2, 32); };
:mulw rd, rs1, rs2 is opcode=0x3B & funct3=0 & funct7=1 & rd & rs1 & rs2 { rd = sext(rs1 * rs2, 32); };
:divw rd, rs1, rs2 is opcode=0x3B & funct3=4 & funct7=1 & rd & rs1 & rs2 { rd = sext(rs1 s/ rs2, 32); };
:divuw rd, rs1, rs2 is opcode=0x3B & funct3=5 & funct7=1 & rd & rs1 & rs2 { rd = sext(rs1 / rs2, 32); };
:remw rd, rs1, rs2 is opcode=0x3B & funct3=6 & funct7=1 & rd & rs1 & rs2 { rd = sext(rs1 s% rs2, 32); };
:remuw rd, rs1, rs2 is opcode=0x3B & funct3=7 & funct7=1 & rd & rs1 & rs2 { rd = sext(rs1 % rs2, 32); };
