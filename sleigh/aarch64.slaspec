:ldx_po rt, rt2, rn, imm7 is size2=2 & s29=1 & f28_27=1 & b26=0 & b25=0 & b24=0 & op23=1 & b22=1 & imm7:imm7 & rt2:rt2 & rn:rn & rt:rt { rt = zext(load(rn + (sext(imm7, 7) << 3), 8)); rt2 = zext(load(rn + (sext(imm7, 7) << 3) + 8, 8)); };

// ===================== adr/adrp =====================
:adr rd, imm19 is sf31=0 & f28_24=16 & imm19:imm19 & rd:rd { rd = inst_start + sext(imm19 << 2, 21); };
:adrp rd, imm19 is sf31=1 & f28_24=16 & imm19:imm19 & rd:rd { rd = ((inst_start >> 12) << 12) + sext(imm19 << 14, 33); };
