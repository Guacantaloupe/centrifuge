:xor dst, src is opcode=0x30 & modrm1 & rreg8:src & rmmem:dst { *(dst) = load(dst, 1) ^ src; };
:xor dst, src is opcode=0x31 & modrm1 & rreg:src & rmmem:dst { *(dst) = load(dst) ^ src; };
:xor dst, src is opcode=0x32 & modrm1 & rreg8:dst & rmmem:src { dst = dst ^ load(src, 1); };
:xor dst, src is opcode=0x33 & modrm1 & rreg:dst & rmmem:src { dst = dst ^ load(src); };
:cmp dst, src is opcode=0x38 & modrm1 & rreg8:src & rmmem:dst { *(dst) = load(dst, 1) - src; };
:cmp dst, src is opcode=0x39 & modrm1 & rreg:src & rmmem:dst { *(dst) = load(dst) - src; };
:cmp dst, src is opcode=0x3A & modrm1 & rreg8:dst & rmmem:src { dst = dst - load(src, 1); };
